# Cloud PartnerOps — local environment template. Copy to .env (never commit .env).
# Everything here has safe local-development defaults.

# ---- Compose ----
POSTGRES_USER=partnerops
POSTGRES_PASSWORD=cpo-pg-1
POSTGRES_DB=partnerops
# Migration role (owns schema, NOT BYPASSRLS by default in prod; local dev uses it directly)
POSTGRES_MIGRATION_USER=partnerops_migrate
POSTGRES_MIGRATION_PASSWORD=cpo-pg-1
REDIS_PASSWORD=cpo-redis-1

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cpo-minio-1

# ---- API ----
APP_ENV=local                 # local | test | staging | production
SECRET_KEY=cpo-dev-secret-8f14e45fceea167a
DATABASE_URL=postgresql+psycopg://partnerops:cpo-app@127.0.0.1:5432/partnerops
DATABASE_URL_MIGRATE=postgresql+psycopg://partnerops_migrate:cpo-pg-1@127.0.0.1:5432/partnerops
REDIS_URL=redis://127.0.0.1:6379/0
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=partnerops-raw
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=cpo-minio-1
OBJECT_STORAGE_USE_SSL=false
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=cpo_session
CSRF_COOKIE_NAME=cpo_csrf
ACCESS_LOG_LEVEL=info
# Auth
ACCESS_TOKEN_TTL_MINUTES=720
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Seed refuses unless APP_ENV is local/test
SEED_DEMO_PASSWORD=Demo-2026-LocalOnly
# Billing engine
CALC_ENGINE_VERSION=0.1.0
PARSER_VERSION_AWS_CUR=1
# High-impact approval threshold (customer-visible amount, major units)
APPROVAL_THRESHOLD_DEFAULT=5000
# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BRAND_NAME=Cloud PartnerOps
